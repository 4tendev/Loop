GMAIL_SMTP_USER="ueremail@gmail.com"
GMAIL_SMTP_APP_PASSWORD="pass"
EMAIL_FROM="ueremail@gmail.com"
REDIS_URL="redis://127.0.0.1:6379"
DATABASE_URL="postgresql://postgres:password@localhost:5433/new_DB"
PRIVATE_BUNNY_ACCESSKEY="bunnyapikey"
storageZoneName="urstorage"
TELEGRAM_BOT_TOKEN="123456:telegram-bot-token-from-botfather"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username_without_at"
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
# STUN addresses are public and contain no credentials.
NEXT_PUBLIC_AVALON_STUN_URL="stun:stun.relay.metered.ca:80"
# Server-only Metered settings used by the authenticated API to generate
# short-lived TURN credentials. Find both under your Metered application;
# the Secret Key is in Dashboard -> Developers. Never add NEXT_PUBLIC_ here.
METERED_DOMAIN="your-metered-app-name.metered.live"
METERED_SECRET_KEY="your-dashboard-developers-secret-key"
